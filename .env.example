# ==============================================================================
# Manospring Healthcare Platform — Environment Variables
# ==============================================================================
# Most features (specialists, 4-step booking, consultations, sessions) run on 
# built-in mock data out-of-the-box. No database configuration required.
#
# ONLY the Personal Wellness Guide (chat) requires an API key if you want
# live AI responses. If omitted, it automatically uses built-in offline responses.
#
# Setup:
# 1. Copy this file to create a local .env:
#    cp .env.example .env
# 2. Add your Groq API key below in .env
# 3. .env is ignored by Git and will NEVER be pushed to GitHub.
# ==============================================================================

# Server Port (Render and Railway provide this automatically)
PORT=3000

# Node Environment
NODE_ENV=production

# Groq Cloud API Key (Optional — for live AI chat)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier
GROQ_MODEL=openai/gpt-oss-20b
